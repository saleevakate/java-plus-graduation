                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"annotation\": \"Проверь себя на прочность в городском чемпионате ловкости и баланса. Бег с яйцом на ложке, ходьба по бревну, метание мешков и другие испытания — для взрослых и детей.\",\n    \"category\": {{categoryId1}},\n    \"description\": \"Настоящий городской праздник спорта и смеха. В программе: эстафета с яйцом в ложке, полоса препятствий на скорость, метание мешков в цель и командный квест на баланс. Три возрастные категории, судьи с секундомерами, призы и море позитива. Начало в 12:00.\",\n    \"eventDate\": \"2027-08-10 12:00:00\",\n    \"location\": {\n        \"lat\": 55.7900,\n        \"lon\": 37.6500\n    },\n    \"paid\": true,\n    \"participantLimit\": 1000,\n    \"requestModeration\": false,\n    \"title\": \"Городской чемпионат ловкости и баланса\"\n}"
            },
