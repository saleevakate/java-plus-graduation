      "name": "3. Test Search (геолокация)",
      "item": [
        {
          "name": "Request 500 m",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Статус 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Ожидается 1 событие\", function () {",
                  "    const events = pm.response.json();",
                  "    pm.expect(events.length).to.eql(1);",
                  "});",
                  "pm.test(\"Событие '41 год Назад в будущее'\", function () {",
                  "    const events = pm.response.json();",
